    m_PersistentCalls:
      m_Calls: []
  m_text: "B\u1EA1n t\u1EC9nh d\u1EADy gi\u1EEFa khu r\u1EEBng nguy\xEAn sinh ph\u1EE7
    d\xE0y s\u01B0\u01A1ng m\xF9 t\xEDm. Kh\xF4ng c\xF3 k\xFD \u1EE9c, kh\xF4ng c\xF3
    v\u0169 kh\xED, ch\u1EC9 c\xF3 ti\u1EBFng r\xE8 c\u1EE7a m\u1ED9t chi\u1EBFc
    <b>\u0111\xE0i Radio c\u0169</b> v\u1ECDng ra t\u1EEB xa.\n\nQua l\xE0n s\xF3ng
    nhi\u1EC5u lo\u1EA1n, gi\u1ECDng m\u1ED9t ng\u01B0\u1EDDi \u0111\xE0n \xF4ng
    c\u1ED5 x\u01B0a vang l\xEAn: <i>\"Con \u01A1i\u2026 \u0111\u1EEBng ph\xE1 r\u1EEBng\u2026
    \u0111\u1EEBng ph\xE1 r\u1EEBng\u2026\"</i>\n\n\u0110\xF3 l\xE0 <color=#2ED07A><b>Mai
    An Ti\xEAm</b></color> \u2014 ng\u01B0\u1EDDi \u0111\xE3 t\u1ED3n t\u1EA1i h\u01A1n
    300 n\u0103m, b\u1EA3o v\u1EC7 ranh gi\u1EDBi gi\u1EEFa hai th\u1EBF gi\u1EDBi."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
