--- !u!114 &1925582598
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1925582596}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#AA55FF><b>\u2500\u2500  NH\xD3M PH\xC1T TRI\u1EC2N  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</b></color>\n\n 
    Tr\u01B0\u1EDFng Nh\xF3m  /  Game Designer\n  <color=#F5A623><b>[ T\xEAn tr\u01B0\u1EDFng
    nh\xF3m ]</b></color>  \xB7  VTC Academy\n\n  L\u1EADp Tr\xECnh (Unity C#)\n 
    <color=#2ED07A><b>[ T\xEAn l\u1EADp tr\xECnh vi\xEAn 1 ]</b></color>\n  <color=#2ED07A><b>[
    T\xEAn l\u1EADp tr\xECnh vi\xEAn 2 ]</b></color>\n\n  \u0110\u1ED3 Ho\u1EA1 
    /  3D Art  /  UI Design\n  <color=#4488FF><b>[ T\xEAn artist ]</b></color>\n\n 
    \xC2m Nh\u1EA1c  /  Sound Design\n  <color=#4488FF><b>[ T\xEAn composer ]</b></color>\n\n 
    Game Tester  /  QA\n  <color=#60727E>[ Danh s\xE1ch tester ]</color>\n\n<color=#AA55FF><b>\u2500\u2500 
    GI\u1EA2NG VI\xCAN H\u01AF\u1EDANG D\u1EAAN  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</b></color>\n\n 
    <color=#F5A623><b>[ T\xEAn Gi\u1EA3ng Vi\xEAn ]</b></color>  \xB7  VTC Academy 
    \xB7  B\u1ED9 M\xF4n Game Development\n\n<color=#AA55FF><b>\u2500\u2500  T\xC0I
    NGUY\xCAN S\u1EEC D\u1EE4NG  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</b></color>\n\n 
    <color=#60727E>Unity 6 LTS  \xB7  TextMeshPro  \xB7  Universal Render Pipeline
    (URP)\n  Devion Games Inventory & Stat System  \xB7  Toby Foliage Engine\n  Terrain
    Evo 3  \xB7  Joystick Pack  \xB7  StarterAssets (ThirdPerson)\n\n  Nh\u1EA1c:
    [ T\xEAn b\xE0i / ngu\u1ED3n ]  \xB7  Hi\u1EC7u \u1EE9ng \xE2m thanh: [ Ngu\u1ED3n
    ]</color>\n\n<color=#AA55FF><b>\u2500\u2500  L\u1EDCI C\u1EA2M \u01A0N  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</b></color>\n\n 
    <color=#60727E>C\u1EA3m \u01A1n gia \u0111\xECnh, b\u1EA1n b\xE8 v\xE0 t\u1EA5t
    c\u1EA3 ng\u01B0\u1EDDi ch\u01A1i \u0111\xE3 \u1EE7ng h\u1ED9.\n  Game \u0111\u01B0\u1EE3c
    t\u1EA1o ra v\u1EDBi t\xECnh y\xEAu d\xE0nh cho v\u0103n ho\xE1 Vi\u1EC7t Nam\n 
    v\xE0 truy\u1EC1n thuy\u1EBFt Mai An Ti\xEAm c\u1ED5 \u0111\u1EA1i.\n\n  \"Khu
    r\u1EEBng kh\xF4ng ch\u1EC9 l\xE0 khung c\u1EA3nh \u2014 \u0111\xF3 l\xE0 nh\xE2n
    v\u1EADt.\"</color>\n\n<color=#AA55FF><b>\u2500\u2500  B\u1EA2N QUY\u1EC0N  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</b></color>\n\n 
    <color=#60727E>\xA9 2025 VTC Academy. B\u1EA3o l\u01B0u m\u1ECDi quy\u1EC1n.\n 
    D\u1EF1 \xE1n h\u1ECDc thu\u1EADt \u2014 kh\xF4ng v\xEC m\u1EE5c \u0111\xEDch
    th\u01B0\u01A1ng m\u1EA1i.</color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
